# Local defaults; copy to .env. Keep credentials outside source control.
TOOLFORGE_DATABASE_URL=sqlite:///var/toolforge.sqlite3
TOOLFORGE_SECRET_KEY=
TOOLFORGE_PUBLIC_URL=http://127.0.0.1:5000
TOOLFORGE_TIMEZONE=Europe/Moscow
# Wikimedia account with admin access. Empty means public reports only.
TOOLFORGE_ADMIN_USERNAME=
TOOLFORGE_START_MONTH=2019-01
TOOLFORGE_QUIET_MINUTES=15
TOOLFORGE_POLL_SECONDS=300
TOOLFORGE_EDIT_INTERVAL=10
TOOLFORGE_MONTH_END_TIME=23:30
# Detailed diagnostics and report snapshots; short page history is permanent.
TOOLFORGE_LOG_RETENTION_DAYS=90
# Wiki writes stay disabled until explicitly enabled at deployment.
TOOLFORGE_WIKI_WRITE=false
TOOLFORGE_BOT_USERNAME=
TOOLFORGE_BOT_LOGIN=
TOOLFORGE_BOT_PASSWORD=
TOOLFORGE_USER_AGENT=ruwiki-works/1.0 (https://github.com/sc113/ruwiki-works)
# Register a login consumer separately from the bot's BotPassword.
TOOLFORGE_OAUTH_KEY=
TOOLFORGE_OAUTH_SECRET=
